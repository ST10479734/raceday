@model Raceday.web.Models.EventViewModel
@{
    ViewData["Title"] = "Event Details & Registration";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="raceday-card p-4 mb-4">
            <h2 class="fw-bold mb-3" style="color: var(--rd-pink-primary);">@Model.EventName</h2>
            <p class="text-muted mb-2"><strong>Location:</strong> @Model.Location</p>
            <p class="text-muted mb-4"><strong>Date:</strong> @Model.EventDate.ToString("yyyy-MM-dd HH:mm")</p>
            <hr />
            <h4 class="mb-3">Available Categories & Distances</h4>

            <div class="list-group">
                @if (Model.Categories != null)
                {
                    @foreach (var cat in Model.Categories)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center p-3 mb-2 raceday-card border">
                            <div>
                                <h5 class="fw-bold mb-1">@cat.CategoryName</h5>
                                <p class="text-muted mb-0">Distance: @cat.Distance | Type: @cat.EventType</p>
                            </div>
                            <form asp-controller="Participant" asp-action="Enrol" method="post" class="d-inline">
                                <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                <input type="hidden" name="amount" value="150.00" />
                                <button type="submit" class="btn btn-raceday-primary btn-sm px-4">Enrol Now</button>
                            </form>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="text-center">
            <a asp-controller="Participant" asp-action="Index" class="text-decoration-none fw-bold" style="color: var(--rd-pink-primary);">← Back to Events</a>
        </div>
    </div>
</div>