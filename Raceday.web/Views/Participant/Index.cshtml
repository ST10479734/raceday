@model List<Raceday.web.Models.EventViewModel>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Available Events</h2>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info rounded-3">
        No upcoming events found at this time.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ev in Model)
        {
            <div class="col">
                <div class="card raceday-card h-100">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@ev.EventName</h5>
                        <p class="card-text text-muted mb-2">
                            <strong>Location:</strong> @ev.Location
                        </p>
                        <p class="card-text text-muted">
                            <strong>Date:</strong> @ev.EventDate.ToString("yyyy-MM-dd HH:mm")
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a asp-controller="Participant" asp-action="EventDetails" asp-route-id="@ev.EventId" class="btn btn-raceday-primary w-100">View Event</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
