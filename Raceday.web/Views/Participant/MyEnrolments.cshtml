@model List<Raceday.web.Models.ResultViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Enrolments & History</h2>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info rounded-3">You are not currently enrolled in any events.</div>
}
else
{
    <div class="table-responsive raceday-card p-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Event Name</th>
                    <th>Category</th>
                    <th>Race Number</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.EventName</td>
                        <td>@item.CategoryName</td>
                        <td><span class="badge bg-secondary">@item.RaceNumber</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
