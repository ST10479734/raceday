@model List<Raceday.web.Models.ResultViewModel>
@{
    ViewData["Title"] = "My Race Results";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Race Results</h2>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info rounded-3">
        You have no race results recorded yet.
    </div>
}
else
{
    <div class="table-responsive raceday-card p-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Event Name</th>
                    <th>Category</th>
                    <th>Race Number</th>
                    <th>Finish Time</th>
                    <th>Overall Position</th>
                    <th>Category Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model)
                {
                    <tr>
                        <td class="fw-bold">@result.EventName</td>
                        <td>@result.CategoryName</td>
                        <td><span class="badge bg-secondary">@result.RaceNumber</span></td>
                        <td>@result.FinishTime</td>
                        <td><span class="badge bg-success">@result.OverallPosition</span></td>
                        <td><span class="badge bg-info text-dark">@result.CategoryPosition</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
